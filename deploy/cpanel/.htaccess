# ============================================================
# PSM VALVE — نمونهٔ .htaccess برای هاست اشتراکی cPanel/CloudLinux
#
# ⚠️ معمولاً پنل cPanel (Setup Node.js App → Node.js selector) خودش این
# فایل را در Application root میسازد. این نمونه فقط برای بازبینی/بازیابی
# است. مقادیر USERNAME و مسیر نسخهٔ Node را با مقادیر واقعی هاست عوض کنید
# (مسیرهای واقعی در پنل cPanel → Setup Node.js App نمایش داده میشوند).
# ============================================================

PassengerAppRoot /home/USERNAME/psm-valve
PassengerBaseURI /
PassengerAppType node
PassengerStartupFile app.js
PassengerNodejs /home/USERNAME/nodevenv/psm-valve/20/bin/node
PassengerFriendlyErrorPages off

# جلوگیری از دسترسی وب به فایلهای پنهان (مثل .env.production)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# فشردهسازی و کش داراییها (اختیاری)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
</IfModule>

# پوشهٔ داده هرگز نباید از وب قابل خواندن باشد
RedirectMatch 404 /data(/|$)