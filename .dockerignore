# ============================================================
# PSM VALVE — فایلهای نادیدهگرفتهشده در بیلد ایمیج Docker
# نکته: public/uploads/ عمداً نادیده گرفته نمیشود تا داراییهای سایت
#       در اولین اجرا داخل volume بازگردانی شوند.
# ============================================================

# وابستگیها و خروجی بیلد (داخل ایمیج از نو ساخته میشوند)
node_modules
.next
out
build
dist

# گیت و محیط
.git
.gitignore
.github
.app-port

# ⚠️ اسرار هرگز داخل ایمیج نمیروند (با env_file/docker compose داده میشوند)
.env
.env.*
!.env.example

# دادهٔ حجیم/موقت
logs
*.log
archive/
tmp-*
.tmp-*
.audit-shots/
data/*.sqlite
data/*.sqlite-*
data/*.bak
data/*.backup
data/*.backup-*
data/*.backup-*.json
data/*.tmp

# ⚠️ دادهٔ خصوصی — هرگز نباید در لایهٔ ایمیج باشد (در زمان اجرا از volume می‌آید)
data/admin.json
data/users.json
data/messages.json

# داراییهای بومی/مستندات
*.xlsx
docs/
tests/
__pycache__/
*.pyc
*.orig
*.backup.js
*.backup-*.js