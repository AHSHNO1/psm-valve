# Required to enable admin authentication. Use a random secret with 32+ bytes.
JWT_SECRET=
ADMIN_USERNAME=
# Option A — plain password (minimum 12 characters), compared in constant time.
ADMIN_PASSWORD=
# Option B (recommended) — bcrypt hash, takes priority over ADMIN_PASSWORD:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=
# Development only: set true to allow exactly admin/admin. Never enable in production.
ADMIN_ALLOW_INSECURE_DEV_CREDENTIALS=
# Optional separate secret for the contact anti-spam challenge.
CONTACT_CHALLENGE_SECRET=
# Configure the reverse proxy to set trusted X-Real-IP / X-Forwarded-For headers.
